# Força HTTPS e usa o domínio sem "www"
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://institutomedicocasagrande.com.br%{REQUEST_URI} [L,R=301]

Options -Indexes
ErrorDocument 404 /404.html

# Arquivos de trabalho do repositório não ficam públicos
RedirectMatch 404 ^/(README\.md|\.gitignore|docs/.*)$

# Cabeçalhos de segurança
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
</IfModule>

# Tipos de arquivo
AddType application/manifest+json .webmanifest
AddType text/plain .txt

# Cache: imagens e fontes por 30 dias; páginas sempre atualizadas
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
